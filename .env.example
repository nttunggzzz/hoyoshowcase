# ==============================================================================
# HoyoShowcase Environment Configuration Template (.env.example)
# Sao chép file này thành .env nếu cần tùy chỉnh cổng hoặc thư mục lưu trữ cục bộ
# ==============================================================================

# Cổng mạng của máy chủ local (mặc định: 47932)
HOYO_PORT=47932

# Đường dẫn thư mục dữ liệu snapshot và lịch sử (mặc định: data/)
HOYO_DATA_DIR=data/
